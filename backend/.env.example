# Database URL (asyncpg for SQLAlchemy 2.0 async)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rfq_auction_db

# Synchronous Database URL (for Alembic migrations)
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/rfq_auction_db

# Security & JWT
SECRET_KEY=super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

